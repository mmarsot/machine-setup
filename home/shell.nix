{ config, ... }:
let
  # Loads the pasted env file (scripts/vault-env.sh). It is a real file outside the
  # Nix store, so no secret is ever evaluated into, or copied to, /nix/store.
  loadEnv = ''
    # shellcheck disable=SC1091
    [ -r "$HOME/.config/machine-setup/load-env.sh" ] && . "$HOME/.config/machine-setup/load-env.sh"
  '';

  # Written at the top of the generated dotfiles. Pasting a token into the file
  # with `sudo nano ~/.bashrc` writes through the symlink into the store, where
  # every account can read it.
  doNotEdit = ''
    # Generated by Home Manager (machine-setup). This file is a read-only link into
    # /nix/store, which every account on this machine can read. Do not edit it, not
    # even with sudo: sudo writes through the link and puts what you type in the store.
    # Tokens go in ~/.config/machine-setup/env (run scripts/vault-env.sh).
  '';
in
{
  programs.bash = {
    enable = true;
    enableCompletion = true;

    # Runs for every bash startup that reads ~/.bashrc, before the
    # interactive-only part, so login, non-interactive and interactive shells all
    # get the env file. The env file is pasted from the Bitwarden note by setup.sh
    # (scripts/vault-env.sh); no secret is ever written here.
    bashrcExtra = doNotEdit + ''
      # Terminals opened before the first re-login still need PATH and FM_*.
      if [ -r "${config.home.profileDirectory}/etc/profile.d/hm-session-vars.sh" ]; then
        # shellcheck disable=SC1091
        . "${config.home.profileDirectory}/etc/profile.d/hm-session-vars.sh"
      fi

    '' + loadEnv;

    # Login shells read ~/.profile (bash through ~/.bash_profile, sh and dash
    # directly), so an agent started with `sh -lc` sees the env file as well.
    profileExtra = doNotEdit + loadEnv;
  };

  # One loader, shared with setup.sh, kept in the repo (scripts/load-env.sh).
  home.file.".config/machine-setup/load-env.sh".source = ../scripts/load-env.sh;

  home.sessionPath = [
    "$HOME/.local/bin" # claude, herdr, treehouse, no-mistakes, npm globals
  ];

  home.sessionVariables = {
    FM_BACKEND = "herdr";
    FM_HOME = "${config.home.homeDirectory}/firstmate";
  };
}
